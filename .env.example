# Synthesis reads .env in the current directory, or --env-file FILE.
# CLI flags override process environment, which overrides this file.
# Values are literal; shell commands and ${VARIABLE} references are not expanded.

DEEPSEEK_API_KEY=
SYNTHESIS_MODEL=deepseek-flash

# Other providers, selected with --provider:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional custom endpoint for --provider auto:
# OPENAI_BASE_URL=http://localhost:8000/v1
